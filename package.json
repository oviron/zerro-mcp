{
  "name": "zerro-mcp",
  "version": "0.1.0",
  "description": "MCP server for Zerro envelope budgets on top of ZenMoney, computed by Zerro's own core",
  "type": "module",
  "bin": {
    "zerro-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "start": "node build/index.js"
  },
  "license": "GPL-2.0-only",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oviron/zerro-mcp.git"
  },
  "keywords": [
    "mcp",
    "zerro",
    "zenmoney",
    "budget",
    "envelope-budgeting"
  ],
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "25.9.9",
    "decimal.js-light": "2.5.1",
    "esbuild": "0.28.2",
    "tldts": "7.4.18",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
